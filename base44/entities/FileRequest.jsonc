{
  "name": "FileRequest",
  "type": "object",
  "properties": {
    "client_email": {
      "type": "string",
      "description": "Email of the client this request is for"
    },
    "title": {
      "type": "string",
      "description": "Name/description of the requested file"
    },
    "description": {
      "type": "string",
      "description": "Additional details about what is needed"
    },
    "category": {
      "type": "string",
      "enum": [
        "\u05dc\u05d5\u05d5\u05d4 1",
        "\u05dc\u05d5\u05d5\u05d4 2",
        "\u05de\u05e9\u05d5\u05ea\u05e3"
      ],
      "description": "Category of the document request"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "uploaded",
        "approved",
        "rejected"
      ],
      "default": "pending"
    },
    "uploaded_files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file_url": {
            "type": "string"
          },
          "file_name": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "admin_notes": {
      "type": "string",
      "description": "Notes from admin"
    }
  },
  "required": [
    "client_email",
    "title"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.client_email": "{{user.email}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.client_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.client_email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}