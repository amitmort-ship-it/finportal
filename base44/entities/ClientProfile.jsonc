{
  "name": "ClientProfile",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "Email address of the client"
    },
    "full_name": {
      "type": "string",
      "description": "Full name of the client"
    },
    "invited": {
      "type": "boolean",
      "description": "Whether the client has been sent an invitation",
      "default": false
    },
    "treatment_ended_at": {
      "type": "string",
      "description": "ISO date when treatment was marked as ended"
    },
    "access_blocked": {
      "type": "boolean",
      "description": "Whether the client's portal access is blocked",
      "default": false
    }
  },
  "required": [
    "email",
    "full_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}