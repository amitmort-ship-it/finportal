{
  "name": "DownloadableDoc",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Document title"
    },
    "file_url": {
      "type": "string",
      "description": "URL of the document"
    },
    "file_name": {
      "type": "string",
      "description": "Original file name"
    },
    "enabled_for": {
      "type": "array",
      "description": "List of client emails this doc is enabled for",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "required": [
    "title",
    "file_url"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}