      ],
      "default": "\u05e4\u05ea\u05d5\u05d7"
    },
    "images": {
      "type": "array",
      "description": "\u05ea\u05de\u05d5\u05e0\u05d5\u05ea \u05d4\u05ea\u05db\u05ea\u05d1\u05d5\u05d9\u05d5\u05ea \u05de\u05e6\u05d5\u05e8\u05e4\u05d5\u05ea",
