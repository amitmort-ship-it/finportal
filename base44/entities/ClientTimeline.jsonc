{
  "name": "ClientTimeline",
  "type": "object",
  "properties": {
    "client_email": {
      "type": "string",
      "description": "Email of the client"
    },
    "stages": {
      "type": "array",
      "description": "Custom stages for this client (overrides global template)",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "estimated_days": {
            "type": "number"
          },
          "next_step": {
            "type": "string"
          }
        }
      },
      "default": []
    }
  },
  "required": [
    "client_email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.client_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}