      "type": "string",
      "description": "\u05de\u05e7\u05d5\u05e8\u05d5\u05ea \u05d4\u05d5\u05df \u05e2\u05e6\u05de\u05d9"
    },
    "current_rent": {
      "type": "number",
      "description": "\u05e9\u05db\u05e8 \u05d3\u05d9\u05e8\u05d4 \u05d7\u05d5\u05d3\u05e9\u05d9 \u05db\u05d9\u05d5\u05dd"
    },
    "clean_credit_report": {
      "type": "boolean",
      "description": "\u05d3\u05d5\u05d7 \u05d0\u05e9\u05e8\u05d0\u05d9 \u05e6\u05e8\u05db\u05e0\u05d9 \u05e0\u05e7\u05d9"
    },
    "financial_issues": {
      "type": "boolean",
      "description": "\u05d4\u05d0\u05dd \u05d4\u05d9\u05d9\u05ea\u05d4 \u05d1\u05e2\u05d9\u05d4 \u05d1\u05d4\u05ea\u05e0\u05d4\u05dc\u05d5\u05ea \u05d4\u05e4\u05d9\u05e0\u05e0\u05e1\u05d9\u05ea"
    },
    "requested_monthly_payment": {
      "type": "number",
      "description": "\u05d4\u05d7\u05d6\u05e8 \u05d7\u05d5\u05d3\u05e9\u05d9 \u05de\u05d1\u05d5\u05e7\u05e9"
    },
    "preferred_payment_day": {
      "type": "string",
      "description": "\u05d9\u05d5\u05dd \u05d4\u05d7\u05d6\u05e8 \u05de\u05d5\u05e2\u05d3\u05e3"
    },
    "grace": {
      "type": "boolean",
      "description": "\u05d2\u05e8\u05d9\u05d9\u05e1"
    },
    "grace_duration": {
      "type": "string",
      "description": "\u05de\u05e9\u05da \u05d2\u05e8\u05d9\u05d9\u05e1"
    },
    "monthly_savings": {
      "type": "boolean",
      "description": "\u05d7\u05d5\u05e1\u05db\u05d9\u05dd \u05db\u05dc \u05d7\u05d5\u05d3\u05e9"
    },
    "monthly_savings_amount": {
      "type": "number",
      "description": "\u05e1\u05db\u05d5\u05dd \u05d7\u05d9\u05e1\u05db\u05d5\u05df \u05d7\u05d5\u05d3\u05e9\u05d9"
    },
    "bank_employee_benefits": {
      "type": "boolean",
      "description": "\u05d4\u05d8\u05d1\u05ea \u05e8\u05d9\u05d1\u05d9\u05d5\u05ea \u05e2\u05d5\u05d1\u05d3\u05d9 \u05d1\u05e0\u05e7"
    },
    "expected_prepayments": {
      "type": "string",
      "description": "\u05e4\u05e8\u05e2\u05d5\u05e0\u05d5\u05ea \u05e2\u05ea\u05d9\u05d3\u05d9\u05d9\u05dd \u05e6\u05e4\u05d5\u05d9\u05d9\u05dd"
    },
    "health_issues": {
      "type": "boolean",
      "description": "\u05d1\u05e2\u05d9\u05d4 \u05d1\u05e8\u05d9\u05d0\u05d5\u05ea\u05d9\u05ea \u05de\u05d9\u05d5\u05d7\u05d3\u05ea"
    },
    "deal_value": {
      "type": "number",
      "description": "\u05d2\u05d5\u05d1\u05d4 \u05e2\u05e1\u05e7\u05d4 \u2014 \u05e9\u05d5\u05d5\u05d9 \u05d4\u05ea\u05d9\u05e7 (\u05e2\u05de\u05dc\u05d4 \u05e6\u05e4\u05d5\u05d9\u05d4)"
    },
    "personal_notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea \u05d0\u05d9\u05e9\u05d9\u05d5\u05ea"
    }
  },
  "required": [
    "lead_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
