    "financial_wealth": {
      "type": "string",
      "description": "\u05e2\u05d5\u05e9\u05e8 \u05e4\u05d9\u05e0\u05e0\u05e1\u05d9 \u05d5\u05e0\u05db\u05e1\u05d9\u05dd \u05e0\u05d5\u05e1\u05e4\u05d9\u05dd (\u05e4\u05d9\u05e7\u05d3\u05d5\u05e0\u05d5\u05ea, \u05e7\u05e8\u05e0\u05d5\u05ea, \u05d7\u05e1\u05db\u05d5\u05e0\u05d5\u05ea)"
