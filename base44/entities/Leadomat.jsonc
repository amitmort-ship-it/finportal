    },
    "followup_notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea \u05dc\u05de\u05e2\u05e7\u05d1 \u05d4\u05d1\u05d0"
    },
    "source": {
      "type": "string",
      "enum": [
        "\u05d4\u05de\u05dc\u05e6\u05d5\u05ea",
        "\u05dc\u05e7\u05d5\u05d7 \u05d7\u05d5\u05d6\u05e8",
        "\u05e4\u05e8\u05e1\u05d5\u05dd",
        "\u05d4\u05d9\u05db\u05e8\u05d5\u05ea \u05d0\u05d9\u05e9\u05d9\u05ea",
        "\u05d0\u05d7\u05e8"
      ],
      "description": "\u05de\u05e7\u05d5\u05e8 \u05d4\u05dc\u05d9\u05d3"
    },
    "referrer_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05de\u05dc\u05d9\u05e5"
    },
    "phone": {
      "type": "string",
      "description": "\u05d8\u05dc\u05e4\u05d5\u05df \u05d0\u05d9\u05e9 \u05e7\u05e9\u05e8 \u05e8\u05d0\u05e9\u05d9"
    },
    "borrower1": {
