{
  "name": "Leadomat",
  "type": "object",
  "properties": {
    "lead_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05dc\u05d9\u05d3 \u05dc\u05ea\u05e6\u05d5\u05d2\u05d4"
    },
    "status": {
      "type": "string",
      "enum": [
        "\u05d7\u05d3\u05e9",
        "\u05d1\u05d8\u05d9\u05e4\u05d5\u05dc",
        "\u05de\u05d5\u05db\u05e9\u05e8",
        "\u05dc\u05d0 \u05de\u05d5\u05db\u05e9\u05e8",
        "\u05e0\u05e1\u05d2\u05e8"
      ],
      "default": "\u05d7\u05d3\u05e9",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05dc\u05d9\u05d3"
    },
    "pipeline_stage": {
      "type": "string",
      "enum": [
        "\u05dc\u05d9\u05d3",
        "\u05e4\u05d2\u05d9\u05e9\u05d4",
        "\u05d4\u05e6\u05e2\u05d4",
        "\u05d7\u05ea\u05d9\u05de\u05d4"
      ],
      "default": "\u05dc\u05d9\u05d3",
      "description": "\u05e9\u05dc\u05d1 \u05d1\u05e6\u05d9\u05e0\u05d5\u05e8 \u05d4\u05de\u05db\u05d9\u05e8\u05d5\u05ea"
    },
    "next_followup_date": {
      "type": "string",
      "format": "date",
